{
  "name": "@colibri/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/platform/database/migrations && cp src/platform/database/migrations/*.sql dist/platform/database/migrations/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "tsx src/platform/database/migrate-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1101.0",
    "@colibri/contracts": "*",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.2",
    "@fastify/type-provider-typebox": "6.1.0",
    "fastify": "5.11.0",
    "fastify-plugin": "5.1.0",
    "pg": "8.22.0",
    "typebox": "1.3.9"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.18.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12"
  }
}
